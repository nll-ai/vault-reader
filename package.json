{
  "name": "vault-reader",
  "version": "0.1.1",
  "description": "Paginated, EPUB-style web reader for Obsidian vaults. Works on e-ink (Boox) and iPhone.",
  "type": "module",
  "license": "MIT",
  "author": "Eric Ma",
  "repository": {
    "type": "git",
    "url": "https://github.com/nll-ai/vault-reader.git"
  },
  "keywords": [
    "obsidian",
    "vault",
    "reader",
    "epub",
    "e-ink",
    "paginated",
    "pwa"
  ],
  "bin": {
    "vault-reader": "./cli.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./vite": "./vite-plugin.mjs",
    "./processor": "./vault.mjs"
  },
  "files": [
    "cli.mjs",
    "index.mjs",
    "vault.mjs",
    "vite-plugin.mjs",
    "frontend",
    "scripts"
  ],
  "scripts": {
    "dev": "node cli.mjs dev",
    "build": "node cli.mjs build"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "engines": {
    "node": ">=18"
  }
}
